# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
# Token of your Telegram bot (get from @BotFather)
# Токен вашего Telegram бота (получите у @BotFather)

BOT_USERNAME=YourBotUsername
# Username of your Telegram bot (without @)
# Имя пользователя вашего Telegram бота (без @)

# Admin & Manager IDs
SELLER_CHAT_ID=123456789
# Chat ID продавца для получения уведомлений о заказах
# Чтобы узнать свой chat_id, напишите боту @userinfobot
# Например: "123456789" или "@username"
# Chat ID of the seller to receive notifications about orders
# To find out your chat_id, write to the bot @userinfobot
# For example: "123456789" or "@username"

SUPPORT_MANAGER_ID=123456789
# Chat ID менеджера поддержки для связи с клиентами
# Чтобы узнать свой chat_id, напишите боту @userinfobot
# Например: "123456789" или "@username"
# Support manager chat ID for customer communication
# To find out your chat_id, write to the bot @userinfobot

# Google Sheets Configuration
GOOGLE_DISK_ID=your_google_sheet_id_here
# ID таблицы в Google Sheets (из URL таблицы)
# Google Sheet ID (from the spreadsheet URL)
# Example URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
# Пример URL: https://docs.google.com/spreadsheets/d/ВАШ_ID_ТАБЛИЦЫ/edit

JSON_KEY_FILE=credentials.json
# Путь к вашему JSON файлу с учетными данными Google API
# Path to your JSON file with Google API credentials
# For local run: credentials.json
# For Docker: /app/credentials.json
# (вам нужно создать Service Account (Сервисный аккаунт) в консоли Google Cloud.)
# (You need to create a Service Account in the Google Cloud Console.)

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Stripe Secret Key (get from Stripe Dashboard)
# Stripe секретный ключ (получите в панели Stripe)

STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Stripe Publishable Key (get from Stripe Dashboard)
# Stripe публичный ключ (получите в панели Stripe)

# Application Settings
ENVIRONMENT=production
# Environment: development or production
# Окружение: development или production

LOG_LEVEL=INFO
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL

PAYMENT_POLL_INTERVAL=60
# Payment status check interval in seconds
# Интервал проверки статуса платежа в секундах

PAYMENT_MAX_AGE_HOURS=24
# Maximum age of payment in hours before expiration
# Максимальный возраст платежа в часах до истечения срока